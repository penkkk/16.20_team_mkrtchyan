metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
# Use the same secrets as in infra/garage/.env.
rpc_secret = "REPLACE_WITH_GARAGE_RPC_SECRET"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
public_endpoint = "http://s3.localhost"
public_endpoint_path_style = true

[s3_web]
bind_addr = "[::]:3902"
root_domain = ".web.garage.localhost"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "REPLACE_WITH_GARAGE_ADMIN_TOKEN"
metrics_token = "REPLACE_WITH_GARAGE_METRICS_TOKEN"
